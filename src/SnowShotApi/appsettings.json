{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Policy": {
    "Revision": 10,
    "PrincipalDailyAllowanceNanoYuan": 3000000000,
    "DailyOperatorBudgetNanoYuan": 50000000000,
    "MonthlyOperatorBudgetNanoYuan": 1000000000000,
    "ActiveLeaseTtlSeconds": 30,
    "LeaseRenewalSeconds": 10,
    "Estimation": {
      "BytesPerInputToken": 3,
      "CharsPerOutputToken": 2
    },
    "Resources": {
      "translation": {
        "RequestsPerMinute": 30,
        "PerPrincipalConcurrency": 4,
        "GlobalConcurrency": 32,
        "GlobalQueueLength": 64,
        "QueueWaitSeconds": 30,
        "ExecutionDeadlineSeconds": 300,
        "OperatorMaximumNanoYuan": 30000000
      },
      "qwen3.8-flash": {
        "RequestsPerMinute": 60,
        "PerPrincipalConcurrency": 4,
        "GlobalConcurrency": 64,
        "GlobalQueueLength": 128,
        "QueueWaitSeconds": 30,
        "ExecutionDeadlineSeconds": 300,
        "OperatorMaximumNanoYuan": 30000000
      },
      "qwen3-vl-flash": {
        "RequestsPerMinute": 60,
        "PerPrincipalConcurrency": 4,
        "GlobalConcurrency": 64,
        "GlobalQueueLength": 128,
        "QueueWaitSeconds": 30,
        "ExecutionDeadlineSeconds": 300,
        "OperatorMaximumNanoYuan": 30000000
      },
      "qwen-mt-flash": {
        "RequestsPerMinute": 30,
        "PerPrincipalConcurrency": 2,
        "GlobalConcurrency": 16,
        "GlobalQueueLength": 32,
        "QueueWaitSeconds": 30,
        "ExecutionDeadlineSeconds": 300,
        "OperatorMaximumNanoYuan": 30000000
      },
      "table-extraction": {
        "RequestsPerMinute": 6,
        "PerPrincipalConcurrency": 2,
        "GlobalConcurrency": 3,
        "GlobalQueueLength": 8,
        "QueueWaitSeconds": 30,
        "ExecutionDeadlineSeconds": 60,
        "OperatorMaximumNanoYuan": 30000000
      }
    },
    "Pricing": {
      "translation": {
        "InputRateNanoYuan": 2000,
        "OutputRateNanoYuan": 8000
      },
      "qwen3.8-flash": {
        "InputRateNanoYuan": 800,
        "OutputRateNanoYuan": 2700
      },
      "qwen3-vl-flash": {
        "InputRateNanoYuan": 150,
        "OutputRateNanoYuan": 1500
      },
      "qwen-mt-flash": {
        "InputRateNanoYuan": 700,
        "OutputRateNanoYuan": 1950
      },
      "table-extraction": {
        "InputRateNanoYuan": 30000000,
        "OutputRateNanoYuan": 0
      }
    }
  },
  "Providers": {
    "Circuit": {
      "ConsecutiveFailuresToOpen": 5,
      "MinimumThroughput": 10,
      "FailureRatio": 0.5,
      "SamplingSeconds": 30,
      "InitialBreakSeconds": 60,
      "MaximumBreakSeconds": 600,
      "MaximumBackoffLevel": 5,
      "HalfOpenSuccessesToClose": 2,
      "ProbeLeaseSeconds": 90,
      "StableResetSeconds": 1800,
      "StateTtlSeconds": 86400,
      "InitiallyOpenAccesses": []
    },
    "Chat": {
      "MaximumSseLineBytes": 262144,
      "MaximumErrorBodyBytes": 65536
    },
    "Translation": {
      "LogicalModels": [
        "qwen3.8-flash",
        "qwen-mt-flash"
      ],
      "MaximumConcurrentConversations": 8,
      "MaximumAttemptsPerConversation": 3,
      "AttemptTimeoutSeconds": 90,
      "InitialRetryDelayMilliseconds": 250,
      "MaximumRetryDelayMilliseconds": 2000
    },
    "CloudProviders": {
      "aliyun": {
        "Endpoint": "https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions",
        "TranslationEnableThinking": false
      }
    },
    "Models": {
      "qwen3.8-flash": {
        "Order": 10,
        "Thinking": true,
        "SupportVision": false,
        "Accesses": {
          "aliyun": {
            "Provider": "aliyun",
            "UpstreamModel": "qwen3.8-flash",
            "MaxConcurrentRequests": 64
          }
        }
      },
      "qwen3-vl-flash": {
        "Order": 30,
        "Thinking": true,
        "SupportVision": true,
        "Accesses": {
          "aliyun": {
            "Provider": "aliyun",
            "UpstreamModel": "qwen3-vl-flash",
            "MaxConcurrentRequests": 64
          }
        }
      },
      "qwen-mt-flash": {
        "Order": 40,
        "Thinking": false,
        "SupportVision": false,
        "MergesSystemIntoUser": true,
        "NativeTranslationOptions": true,
        "Accesses": {
          "aliyun": {
            "Provider": "aliyun",
            "UpstreamModel": "qwen-mt-flash",
            "MaxConcurrentRequests": 16
          }
        }
      }
    },
    "Table": {
      "MaximumUploadBytes": 819200
    }
  },
  "Retention": {
    "OperationDays": 90,
    "AggregateDays": 400,
    "IdentityDays": 400
  },
  "Maintenance": {
    "ReconciliationBatchSize": 100,
    "ReconciliationIdleSeconds": 30,
    "BusyDelayMilliseconds": 100,
    "FailureDelaySeconds": 5,
    "RetentionBatchSize": 10000,
    "RetentionIntervalHours": 6,
    "DependencyStatusStaleSeconds": 300
  },
  "Redis": {
    "DeploymentMode": "development-single-node"
  },
  "TrustedProxies": ["127.0.0.1", "::1"],
  "AllowedHosts": "*"
}
