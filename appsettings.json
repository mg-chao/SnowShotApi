{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AITranslation": {
    "ContentLengthLimit": 1000000,
    "AttemptTimeoutSeconds": 60,
    "BatchTimeoutSeconds": 180,
    "MaxAttemptsPerSegment": 3,
    "MaxRetryDelaySeconds": 5,
    "CircuitFailureThreshold": 3,
    "CircuitBreakSeconds": 30,
    "StaleReservationGraceSeconds": 300,
    "ReservationCleanupIntervalSeconds": 60,
    "QuotaTimeZoneId": "Asia/Shanghai",
    "Providers": {
      "AlibabaCloud": {
        "Endpoint": "https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions",
        "ApiKey": "",
        "ThinkingMode": "EnableThinkingFalse",
        "UserIdentifierField": "User"
      },
      "DeepSeekCloud": {
        "Endpoint": "https://api.deepseek.com/chat/completions",
        "ApiKey": "",
        "ThinkingMode": "DisabledObject",
        "UserIdentifierField": "UserId"
      }
    },
    "Models": {
      "QwenFlash": {
        "ProviderId": "AlibabaCloud",
        "Model": "qwen3.6-flash",
        "Enabled": true,
        "Weight": 1,
        "MaxConcurrency": 32,
        "MaxOutputTokens": 16384,
        "ResponseFormat": "JsonObject"
      },
      "AlibabaDeepSeekFlash": {
        "ProviderId": "AlibabaCloud",
        "Model": "deepseek-v4-flash",
        "Enabled": true,
        "Weight": 1,
        "MaxConcurrency": 32,
        "MaxOutputTokens": 16384,
        "ResponseFormat": "JsonObject"
      },
      "DeepSeekCloudFlash": {
        "ProviderId": "DeepSeekCloud",
        "Model": "deepseek-v4-flash",
        "Enabled": true,
        "Weight": 1,
        "MaxConcurrency": 32,
        "MaxOutputTokens": 16384,
        "ResponseFormat": "JsonObject"
      }
    }
  },
  "AllowedHosts": "*"
}
